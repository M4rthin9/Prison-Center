# ── runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8787
API_BASE_URL=http://localhost:8787
# Comma-separated. Must list every origin that sends credentialed requests.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── database ──────────────────────────────────────────────────────────────
DATABASE_PATH=./data/app.db

# ── auth ──────────────────────────────────────────────────────────────────
# 32+ bytes. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Set to 1 behind TLS in production (required for SameSite=None too).
COOKIE_SECURE=0
COOKIE_DOMAIN=

# ── adapters ──────────────────────────────────────────────────────────────
STORAGE_ADAPTER=local          # local | s3
STORAGE_LOCAL_DIR=./data/uploads
STORAGE_PUBLIC_PATH=/files
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── จดหมายอิเล็กทรอนิกส์ (เฟส 4) ──────────────────────────────────────────
# auto = ใช้ Playwright ถ้าติดตั้งไว้ ถ้าไม่มีจะเก็บเป็น HTML พร้อมสั่งพิมพ์ A4
# ติดตั้งเครื่องพิมพ์จริง: pnpm --filter @pc/api add playwright
#                        pnpm --filter @pc/api exec playwright install chromium
LETTER_RENDERER=auto           # auto | playwright | html

NOTIFIER_ADAPTER=console       # console | in_app | line
NOTIFIER_OUTBOX_PATH=./data/outbox.log

# ── LINE (เฟส 7) ─────────────────────────────────────────────────────────
# LINE Login channel — LINE_CHANNEL_ID คือ audience ที่ ID token ต้องตรงกัน
# ถ้าเว้นว่าง ระบบจะไม่รับคำขอเข้าสู่ระบบ/เชื่อมบัญชีด้วย LINE เลย
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# Messaging API channel — คนละ channel กับ LINE Login
LINE_MESSAGING_TOKEN=
LINE_API_BASE=https://api.line.me
# LIFF ID ของแอปในไลน์ ใช้ทั้งฝั่งหน้าเว็บและปุ่มใน rich menu
LIFF_ID=

# เปิดใช้งานจริงต้องตั้ง 2 คีย์ใน Settings Registry ด้วย:
#   features.line_login = true, line.liff_id = "<LIFF_ID>"
# และตั้ง NOTIFIER_ADAPTER=line เพื่อส่ง push

# ── ตั้งรหัสผ่านใหม่ด้วยตนเอง / OTP (เฟส 7) ──────────────────────────────
# console = เขียนรหัสลง outbox แทนการส่งจริง (เครื่อง dev และเทสต์เท่านั้น)
OTP_ADAPTER=console            # console | sms | line
OTP_TTL_MINUTES=10
# ส่งรหัสกลับมาใน response — production จะปฏิเสธถ้าเปิดไว้
OTP_ECHO=0
SMS_ENDPOINT=
SMS_API_KEY=
SMS_SENDER=PrisonCtr
# เปิดใช้งานจริง: features.self_service_reset = true ใน Settings Registry

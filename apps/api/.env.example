# ── runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8787
API_BASE_URL=http://localhost:8787
# Comma-separated. Must list every origin that sends credentialed requests.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── database ──────────────────────────────────────────────────────────────
DATABASE_PATH=./data/app.db

# ── auth ──────────────────────────────────────────────────────────────────
# 32+ bytes. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Set to 1 behind TLS in production (required for SameSite=None too).
COOKIE_SECURE=0
COOKIE_DOMAIN=

# ── adapters ──────────────────────────────────────────────────────────────
STORAGE_ADAPTER=local          # local | s3
STORAGE_LOCAL_DIR=./data/uploads
STORAGE_PUBLIC_PATH=/files
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

NOTIFIER_ADAPTER=console       # console | in_app | line
NOTIFIER_OUTBOX_PATH=./data/outbox.log

# ── LINE (Phase 7 — unused before then) ──────────────────────────────────
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_MESSAGING_TOKEN=

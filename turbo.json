{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "dev": { "cache": false, "persistent": true, "dependsOn": ["^build"] },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".svelte-kit/output/**"]
    },
    "check": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"], "cache": false }
  }
}
